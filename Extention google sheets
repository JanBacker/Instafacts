import { useEffect, useState } from "react";

export default function SheetDisplay() {
  const [data, setData] = useState(null);
  const SHEET_URL = "YOUR_PUBLISHED_CSV_URL_HERE";

  useEffect(() => {
    fetch(SHEET_URL)
      .then(res => res.text())
      .then(csv => {
        const rows = csv.trim().split("\n").map(r => r.split(","));
        const [img1, img2, img3, caption] = rows[1];
        setData({ img1, img2, img3, caption });
      });
  }, []);

  if (!data) return <p>Loading...</p>;

  return (
    <div className="text-center">
      <div className="flex justify-center gap-4">
        <img src={data.img1} alt="" className="w-40 rounded-xl" />
        <img src={data.img2} alt="" className="w-40 rounded-xl" />
        <img src={data.img3} alt="" className="w-40 rounded-xl" />
      </div>
      <p className="mt-4 text-lg">{data.caption}</p>
    </div>
  );
}
